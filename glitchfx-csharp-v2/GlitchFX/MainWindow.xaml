<Window x:Class="GlitchFX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GlitchFX.Views"
        Title="Glitch FX" Height="860" Width="1400" Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LoadButton" Content="Load Video\u2026" Style="{StaticResource ToolbarButton}" Click="LoadButton_Click"/>
                <TextBlock Text="Seed" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="SeedBox" Width="60" VerticalAlignment="Center"/>
                <Button x:Name="RandomizeButton" Content="Randomize" Style="{StaticResource AccentButton}" Click="RandomizeButton_Click"/>
                <Button x:Name="SavePresetButton" Content="Save Preset\u2026" Style="{StaticResource ToolbarButton}" Click="SavePresetButton_Click"/>
                <Button x:Name="LoadPresetButton" Content="Load Preset\u2026" Style="{StaticResource ToolbarButton}" Click="LoadPresetButton_Click"/>
                <Button x:Name="UndoButton" Content="\u21b6 Undo" Style="{StaticResource ToolbarButton}" Click="UndoButton_Click"/>
                <Button x:Name="RedoButton" Content="\u21b7 Redo" Style="{StaticResource ToolbarButton}" Click="RedoButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main split: inspector (left) + preview (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{StaticResource PanelBrush}">
                    <Button x:Name="EffectsTabButton" Content="Effects" Style="{StaticResource AccentButton}" Margin="8" Click="EffectsTabButton_Click"/>
                    <Button x:Name="OutputTabButton" Content="Output" Style="{StaticResource ToolbarButton}" Margin="0,8,8,8" Click="OutputTabButton_Click"/>
                </StackPanel>
                <Grid>
                    <views:EffectsPanel x:Name="EffectsPanelView"/>
                    <views:OutputPanel x:Name="OutputPanelView" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>

            <views:PreviewControl x:Name="PreviewView" Grid.Column="1"/>
        </Grid>

        <!-- Bottom timeline bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Grid.Column="0" Content="\u25b6\ufe0e" Style="{StaticResource ToolbarButton}" Click="PlayPauseButton_Click"/>
                <Slider x:Name="TimelineSlider" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1"
                        Thumb.DragStarted="TimelineSlider_DragStarted" Thumb.DragCompleted="TimelineSlider_DragCompleted"/>
                <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" VerticalAlignment="Center" Style="{StaticResource SubText}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
