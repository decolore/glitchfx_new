<Window x:Class="GlitchFX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GlitchFX.Views"
        Title="Glitch FX" Height="900" Width="1460" Background="{StaticResource BgBrush}"
        AllowDrop="True" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LoadButton" Style="{StaticResource ToolbarButton}" Click="LoadButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" RadiusX="2" RadiusY="2" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line X1="7" Y1="2" X2="7" Y2="22" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line X1="17" Y1="2" X2="17" Y2="22" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line X1="2" Y1="12" X2="22" Y2="12" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line X1="2" Y1="7" X2="7" Y2="7" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line X1="2" Y1="17" X2="7" Y2="17" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line X1="17" Y1="17" X2="22" Y2="17" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line X1="17" Y1="7" X2="22" Y2="7" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Load Video…"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Seed" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="SeedBox" Width="60" VerticalAlignment="Center"/>
                <Button x:Name="RandomizeButton" Style="{StaticResource AccentButton}" Click="RandomizeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Polyline Points="16,3 21,3 21,8" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="4" Y1="20" X2="21" Y2="3" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Polyline Points="21,16 21,21 16,21" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="15" Y1="15" X2="21" Y2="21" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="4" Y1="4" X2="9" Y2="9" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Randomize" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SavePresetButton" Style="{StaticResource ToolbarButton}" Click="SavePresetButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Polyline Points="17,21 17,13 7,13 7,21" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                <Polyline Points="7,3 7,8 15,8" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Save Preset…"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LoadPresetButton" Style="{StaticResource ToolbarButton}" Click="LoadPresetButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Load Preset…"/>
                    </StackPanel>
                </Button>
                <Button x:Name="UndoButton" Style="{StaticResource ToolbarButton}" Click="UndoButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Polyline Points="9,14 4,9 9,4" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                <Path Data="M20 20v-7a4 4 0 0 0-4-4H4" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Undo"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource ToolbarButton}" Click="RedoButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Polyline Points="15,14 20,9 15,4" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                <Path Data="M4 20v-7a4 4 0 0 1 4-4h12" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Redo"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main split: inspector (left) + preview (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="8">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EffectsTabButton" Content="Effects" Padding="14,6" Style="{StaticResource SegmentButtonSelected}" Click="EffectsTabButton_Click"/>
                            <Button x:Name="OutputTabButton" Content="Output" Padding="14,6" Style="{StaticResource SegmentButtonUnselected}" Click="OutputTabButton_Click"/>
                        </StackPanel>
                    </Border>
                </Border>
                <Grid>
                    <views:EffectsPanel x:Name="EffectsPanelView"/>
                    <views:OutputPanel x:Name="OutputPanelView" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>

            <views:PreviewControl x:Name="PreviewView" Grid.Column="1"/>
        </Grid>

        <!-- Bottom timeline bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Grid.Column="0" Style="{StaticResource ToolbarButton}" Click="PlayPauseButton_Click">
                    <Grid>
                        <Viewbox x:Name="PlayIcon" Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Polygon Points="5,3 19,12 5,21" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="PauseIcon" Width="14" Height="14" Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="6" Canvas.Top="4" Width="4" Height="16" Fill="{StaticResource TextBrush}"/>
                                <Rectangle Canvas.Left="14" Canvas.Top="4" Width="4" Height="16" Fill="{StaticResource TextBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
                <Grid Grid.Column="1" Margin="12,0">
                    <Canvas x:Name="TimelineTicksCanvas" Height="20" IsHitTestVisible="False" SizeChanged="TimelineTicksCanvas_SizeChanged"/>
                    <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1"
                            IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="TimelineSlider_ValueChanged"/>
                </Grid>
                <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" VerticalAlignment="Center" Style="{StaticResource SubText}"/>
            </Grid>
        </Border>

        <!-- Drag &amp; drop overlay: shown while a valid video file is being dragged over the window. -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Drop video to load" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="MP4 · MOV · MKV · AVI" FontSize="12" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
