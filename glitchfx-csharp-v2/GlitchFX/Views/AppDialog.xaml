<Window x:Class="GlitchFX.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glitch FX" Width="440" MinHeight="200" MaxHeight="520" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            CornerRadius="12" Margin="16" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="IconText" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleTextBlock" Style="{StaticResource CardHeaderText}" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="320" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextBrush}" Cursor="Hand"
                               ToolTip="Click to copy this message" MouseLeftButtonDown="MessageTextBlock_Click"/>
                    <TextBlock x:Name="CopiedHintText" Text="Copied to clipboard" Style="{StaticResource SubText}"
                               Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource ToolbarButton}" Padding="16,7" Margin="0,0,8,0" Click="CancelButton_Click" Visibility="Collapsed"/>
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource AccentButton}" Padding="22,7" Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
