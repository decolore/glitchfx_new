<Window x:Class="GlitchFX.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glitch FX" Height="200" Width="400" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            CornerRadius="12" Margin="16" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="IconText" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleTextBlock" Style="{StaticResource CardHeaderText}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageTextBlock" Grid.Row="1" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource AccentButton}" Padding="22,7" Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
