<UserControl x:Class="GlitchFX.Views.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource PanelBrush}" Padding="12">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Output Size" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Width" Style="{StaticResource SubText}"/>
                            <TextBox x:Name="WidthBox" Margin="0,2,0,0" TextChanged="OnTransformChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height" Style="{StaticResource SubText}"/>
                            <TextBox x:Name="HeightBox" Margin="0,2,0,0" TextChanged="OnTransformChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Fit" Style="{StaticResource SubText}" Margin="0,8,0,0"/>
                    <ComboBox x:Name="FitCombo" Margin="0,2,0,0" SelectionChanged="OnTransformChanged">
                        <ComboBoxItem Content="cover"/>
                        <ComboBoxItem Content="contain"/>
                        <ComboBoxItem Content="stretch"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Export" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8"/>
                    <TextBlock Text="Codec" Style="{StaticResource SubText}"/>
                    <ComboBox x:Name="CodecCombo" Margin="0,2,0,2" SelectionChanged="OnExportChanged">
                        <ComboBoxItem Content="libx264"/>
                        <ComboBoxItem Content="libx265"/>
                        <ComboBoxItem Content="h264_nvenc"/>
                        <ComboBoxItem Content="hevc_nvenc"/>
                        <ComboBoxItem Content="h264_qsv"/>
                        <ComboBoxItem Content="h264_amf"/>
                    </ComboBox>
                    <TextBlock Text="nvenc/qsv/amf use your GPU and are much faster, but need a matching NVIDIA/Intel/AMD card + driver" Style="{StaticResource SubText}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="CRF (quality, lower = better)" Style="{StaticResource SubText}"/>
                    <Slider x:Name="CrfSlider" Minimum="0" Maximum="51" Margin="0,2,0,8" ValueChanged="OnExportChanged"/>
                    <TextBlock Text="Preset" Style="{StaticResource SubText}"/>
                    <ComboBox x:Name="PresetCombo" Margin="0,2,0,8" SelectionChanged="OnExportChanged">
                        <ComboBoxItem Content="ultrafast"/>
                        <ComboBoxItem Content="fast"/>
                        <ComboBoxItem Content="medium"/>
                        <ComboBoxItem Content="slow"/>
                    </ComboBox>
                    <TextBlock Text="Max Bitrate, kbps (optional, e.g. 8000 = 8 Mbps)" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                    <TextBox x:Name="BitrateBox" Margin="0,2,0,8" TextChanged="OnExportChanged" PreviewTextInput="BitrateBox_PreviewTextInput"/>
                    <TextBlock Text="Output Path" Style="{StaticResource SubText}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputPathBox" Grid.Column="0" TextChanged="OnExportChanged"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource ToolbarButton}" Click="BrowseButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Browse…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="ExportButton" Style="{StaticResource AccentButton}" Margin="0,12,0,0" Click="ExportButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
                                    <Polyline Points="7,10 12,15 17,10" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
                                    <Line X1="12" Y1="15" X2="12" Y2="3" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Export Video" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar x:Name="ExportProgress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                    <TextBlock x:Name="ExportProgressText" Style="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
